# Shared
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/fanilo
# Production (Neon, direct connection). Not read by the app; used to migrate production.
PROD_DATABASE_URL=

# apps/web
BETTER_AUTH_SECRET=change-me-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# apps/api
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Checky team: Better Auth user ids (GET /api/v1/me) of the accounts that verify newsrooms
PLATFORM_ADMINS=
# Object storage: Neon Object Storage (S3-compatible). uploads-dev locally, uploads in production.
STORAGE_ENDPOINT=
STORAGE_REGION=eu-central-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=uploads-dev
LLM_PROVIDERS=groq,gemini,nvidia,claude
# Every *_API_KEY may hold several keys separated by commas (one per teammate or free account):
# they are used in turn, and a key that hits its quota is set aside so the next call uses another.
# This covers every outside-service credential: chat, embeddings (Gemini), transcription (Groq Whisper),
# the voice (ElevenLabs), web search (Tavily), fact-checks (Google), and image detection (Sightengine,
# IMAGE_DETECTOR_TOKEN). Paired variables (SIGHTENGINE_API_USER/SECRET) are matched in order.
# Example: GROQ_API_KEY=gsk_mock_alice,gsk_mock_bob
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
# Claude (optional, paid): skipped while empty. Put `claude` first in LLM_PROVIDERS to prefer it.
CLAUDE_API_KEY=
LLM_MODEL_GROQ=
LLM_MODEL_GEMINI=
LLM_MODEL_NVIDIA=
LLM_MODEL_CLAUDE=
# Claude's thinking effort: low (quick, cheap) | medium | high
CLAUDE_EFFORT=low
EMBED_PROVIDER=gemini
EMBED_MODEL=gemini-embedding-2
EMBED_DIM=768
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3
# The agent searches the web (DuckDuckGo) and Wikipedia without any key. Optional: a Google Cloud
# key with the Fact Check Tools API enabled adds claim reviews by fact-checkers worldwide (free).
GOOGLE_FACTCHECK_API_KEY=
# Prefer IPv4 for direct search connections; existing proxy configuration is always respected.
SEARCH_IPV4_ONLY=true
# Dedicated web-search API. auto uses Tavily when the key is set, otherwise legacy best-effort HTML.
# Use only the Researcher/free plan, without a card or pay-as-you-go. Paid/overage accounts are refused.
WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
# AI-generated image detector (optional): https://sightengine.com → API keys (several accounts:
# SIGHTENGINE_API_USER=u1,u2 and SIGHTENGINE_API_SECRET=s1,s2, same order). Images examined by
# the image check are then sent to Sightengine, only once IMAGE_DETECTOR_VALIDATED=true;
# PUBLIC_IMAGE_DETECTOR_ENABLED=true also offers it to the extension's anonymous mode.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
IMAGE_DETECTOR_VALIDATED=false
PUBLIC_IMAGE_DETECTOR_ENABLED=false
# Voice of the assistant's voice mode (optional): https://elevenlabs.io → Profile → API keys.
# Without it the browser's own voice reads the answers. Several free accounts' keys, comma-separated,
# add up their credits: a key out of credits is set aside for an hour.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_MODEL_MG=eleven_v3
# Answers identical requests from app.ai_cache: true while developing and rehearsing the demo
# (re-running an analysis then returns the same answer), false for a fresh answer every time.
AI_CACHE=true
AI_TIMEOUT=30
AI_ATTEMPTS=2
# Optional image pixel detector: POST raw image bytes, return {"ai_score": 0..1, "model": "id"}.
# Leave disabled until evaluated on real/generated images, including compressed copies.
IMAGE_DETECTOR_URL=
IMAGE_DETECTOR_TOKEN=
IMAGE_DETECTOR_VALIDATED=false
# Public extension access: shared text/image request budgets per API process.
PUBLIC_CHECKS_PER_WINDOW=12
PUBLIC_CHECKS_PER_DAY=1000
PUBLIC_CHECKS_CONCURRENCY=2
# One short AI call prepares grounded queries, never a public truth verdict. Claude is excluded.
PUBLIC_PREPARATION_ENABLED=true
PUBLIC_PREPARATION_PROVIDERS=groq,gemini,nvidia
# A private pixel detector is not exposed anonymously without this additional opt-in.
PUBLIC_IMAGE_DETECTOR_ENABLED=false

# Checky: per-issuer seals, verification attestations and the links printed on posters and SMS.
# SEAL_SECRET encrypts the issuers' Ed25519 keys at rest and derives the attestation key; without
# it sealing answers 503. PUBLIC_WEB_URL is the public site (QR codes, /v/<n> short links).
SEAL_SECRET=
PUBLIC_WEB_URL=http://localhost:3000
# Shared secret the SMS gateway phone sends as X-Gateway-Secret on /public/sms/inbound and /outbox.
SMS_GATEWAY_SECRET=
# Optional Android gateway phone. Leave URL empty to use the existing polling outbox.
# Local-server mode: http://<phone-lan-ip>:8080; cloud mode: the gateway's API base URL.
SMS_GATEWAY_URL=
SMS_GATEWAY_USER=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_TOKEN=
# The webhook signing key configured in the phone app; takes precedence over the shared secret.
SMS_GATEWAY_SIGNING_KEY=
# 0 = phone default SIM; 1-3 select a particular SIM.
SMS_GATEWAY_SIM=0
