{
  "name": "fanilo-base",
  "private": true,
  "packageManager": "npm@12.2.1",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "gen:api": "npm run gen:api -w @fanilo/shared",
    "third-party": "uv run --project apps/api python scripts/third_party.py"
  },
  "devDependencies": {
    "turbo": "^2"
  }
}
